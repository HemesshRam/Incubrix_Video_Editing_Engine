PROJECT_NAME="IncuBrix Video Editing Engine"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
# JSON array of browser origins allowed to call the API. Change for deployment.
CORS_ALLOWED_ORIGINS='["http://localhost:8000","http://127.0.0.1:8000"]'

# AI Provider Settings
# Use "mock" for keyless local development, or "groq" with a valid Groq API key.
LLM_PROVIDER="mock"
GROQ_MODEL="openai/gpt-oss-20b"
# GROQ_API_KEY="your-groq-api-key-here"

# Request retry handling
IDEMPOTENCY_BACKEND="memory"
REDIS_URL="redis://localhost:6379/0"
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_PROCESSING_TTL_SECONDS=300
IDEMPOTENCY_MEMORY_LIMIT=4096
MAX_IDEMPOTENCY_BODY_BYTES=10000000

# Storage Settings (local by default; Compose provides an S3-compatible SeaweedFS service)
STORAGE_BACKEND="local"
STORAGE_PATH="storage"
MINIO_ENDPOINT="localhost:8333"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="incubrix-media"

# Processing Settings
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
# Leave blank for automatic language detection, or use a Whisper language code (e.g. ta).
WHISPER_LANGUAGE=""
LLM_CONTEXT_MAX_WORDS=12000
MAX_CONCURRENT_JOBS=4
JOB_PROCESSING_TTL_SECONDS=300
JOB_RETENTION_SECONDS=604800
MAX_UPLOAD_BYTES=2000000000
